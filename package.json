{
  "name": "clean-start-typescript",
  "version": "3.0.1",
  "description": "A Node 26, Express, React, Material UI and TypeScript starter powered by webpack.",
  "type": "module",
  "engines": {
    "node": "26.x",
    "npm": ">=12"
  },
  "scripts": {
    "start": "node dist/service/index.js",
    "start:dev": "webpack serve --mode development",
    "dev:server": "node --watch service/index.ts",
    "dev": "webpack --mode development",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc --noEmit && webpack --mode production",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:generator": "node --test test-cli/*.test.js",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; for (const dir of ['public', 'dist']) rmSync(dir, { recursive: true, force: true });\"",
    "reinstall": "npm ci",
    "rebuild": "npm run clean && npm ci && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Augmentedjs/clean-start-typescript.git"
  },
  "keywords": ["react", "typescript", "express", "mui", "webpack", "starter"],
  "author": "Bob Warren <jedi.master@augmentedjs.com> (http://www.augmentedjs.com)",
  "license": "Apache-2.0",
  "bin": {
    "clean-start-typescript": "./bin/csr.js"
  },
  "files": [
    "bin/",
    "service/",
    "src/",
    "test/",
    "templates/",
    "tsconfig*.json",
    "webpack.config.mjs",
    ".nvmrc",
    ".node-version"
  ],
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.5",
    "favicons-webpack-plugin": "^6.0.1",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.7",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "bugs": {
    "url": "https://github.com/Augmentedjs/clean-start-typescript/issues"
  },
  "homepage": "https://www.augmentedjs.com"
}
